{
  "FileVersion": 3,
  "VersionName": "1.0.0",
  "Version": 2,
  "FriendlyName": "VRM Interchange",
  "Description": "Imports VRM 0.x and 1.0 avatars through Interchange: skeletal mesh, morph targets, MToon materials, spring bone physics, IK Rig, avatar description and a Live Link actor.",
  "Category": "Importers",
  "Modules": [
    {
      "Name": "VRMCore",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "EnabledByDefault": true
    },
    {
      "Name": "VRMInterchange",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "EnabledByDefault": true
    },
    {
      "Name": "VRMInterchangeEditor",
      "Type": "Editor",
      "LoadingPhase": "PreDefault",
      "EnabledByDefault": true,
      "IncludeListPlatforms": [ "Win64" ]
    },
    {
      "Name": "VRMSpringBonesRuntime",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "EnabledByDefault": true
    },
    {
      "Name": "VRMSpringBonesEditor",
      "Type": "UncookedOnly",
      "LoadingPhase": "PostDefault",
      "EnabledByDefault": true,
      "IncludeListPlatforms": [ "Win64" ]
    }
  ],
  "EnabledByDefault": true,
  "Plugins": [
    {
      "Name": "Interchange",
      "Enabled": true
    },
    {
      "Name": "InterchangeEditor",
      "Enabled": true
    },
    {
      "Name": "IKRig",
      "Enabled": true
    },
    {
      "Name": "LiveLink",
      "Enabled": true
    }
  ],

  "CreatedBy": "Lifelike & Believable Animation Design, Inc.",
  "CreatedByURL": "https://www.lifelikeandbelievable.com",
  "DocsURL": "https://github.com/lifelike-and-believable/VMCLiveLink#readme",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/lifelike-and-believable/VMCLiveLink/issues",
  "CanContainContent": true,
  "IsBetaVersion": false,
  "IsExperimentalVersion": false,
  "Installed": false
}
